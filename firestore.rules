rules_version = '2';

// FUSE accounts. Wallets are encrypted in the browser before they're sent, so nothing here holds a
// readable private key, and master emails can't read them either.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isMaster() {
      return isVerified()
        && request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails;
    }
    function isListedMaster() {
      return request.auth != null
        && request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails;
    }
    function isApproved() {
      return request.auth != null
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.status == 'approved';
    }
    function isNotBanned(uid) {
      return !exists(/databases/$(database)/documents/profiles/$(uid))
        || get(/databases/$(database)/documents/profiles/$(uid)).data.status != 'banned';
    }
    function isShortText(value) {
      return value is string && value.size() <= 64;
    }

    function ownsUsername(data) {
      return !('username' in data)
        || get(/databases/$(database)/documents/usernames/$(data.username)).data.uid == request.auth.uid;
    }

    // Lets someone sign in with a username, so anyone who knows a username can look up its email.
    // The list can't be read as a whole, and a username belongs to one account at a time.
    match /usernames/{name} {
      allow get: if true;
      allow create: if request.auth != null
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Master emails, at most 3. The first is added in the Firebase console. Only someone on the
    // list can read it, which tells them to verify. Nothing else works until they have.
    match /config/admins {
      allow read: if isListedMaster();
      allow update: if isMaster()
        && request.resource.data.keys().hasOnly(['emails'])
        && request.resource.data.emails is list
        && request.resource.data.emails.size() >= 1
        && request.resource.data.emails.size() <= 3;
    }

    // Who signed up. Only a master can change a status. Each new ban adds one to banCount,
    // and the third can't be changed.
    match /profiles/{uid} {
      allow get: if isOwner(uid) || isMaster();
      allow list: if isMaster();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'username', 'xUsername', 'discordUsername', 'status', 'createdAt', 'lastSignInAt', 'lastSeenAt'])
        && ownsUsername(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && isShortText(request.resource.data.xUsername)
        && isShortText(request.resource.data.discordUsername)
        && (
          (request.resource.data.status == 'pending'
            && request.resource.data.xUsername.size() > 0
            && request.resource.data.discordUsername.size() > 0)
          || (request.resource.data.status == 'approved' && isMaster())
        );
      allow update: if
        (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'lastSignInAt', 'lastSeenAt'])
          && ownsUsername(request.resource.data))
        || (isMaster()
          && !(resource.data.status == 'banned' && resource.data.get('banCount', 0) >= 3)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'lastSignInAt', 'lastSeenAt', 'banCount'])
          && request.resource.data.get('banCount', 0) == resource.data.get('banCount', 0)
            + (request.resource.data.status == 'banned' && resource.data.status != 'banned' ? 1 : 0)
          && request.resource.data.status in ['pending', 'approved', 'declined', 'removed', 'banned']);

      // Each person's log. It can only be added to, and holds public details, never keys.
      match /events/{eventId} {
        allow read: if isOwner(uid) || isMaster();
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['type', 'at', 'chain', 'from', 'to', 'amount', 'hash', 'status', 'name', 'address'])
          && isShortText(request.resource.data.type)
          && request.resource.data.at is timestamp;
      }
    }

    // One encrypted vault per person. Its owner can read it to export their keys, even if declined
    // or removed, but a ban ends that. Saving needs approval.
    match /vaults/{uid} {
      allow read: if isOwner(uid) && isNotBanned(uid);
      allow delete: if isOwner(uid) && (isApproved() || isMaster());
      allow create, update: if isOwner(uid) && (isApproved() || isMaster())
        && request.resource.data.keys().hasOnly(['vault', 'updatedAt'])
        && request.resource.data.vault is string
        && request.resource.data.vault.size() < 200000;
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
